  },
  {
   "dialogue_id": "K27",
   "lines": [
    {
     "utterance": "털실 있어요?",
     "label": "none",
     "type": "none"
    },
    {
     "utterance": "털실 세 뭉치 따로 챙겨 달라고 했었잖아요.",
