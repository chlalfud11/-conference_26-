     "type": "claim"
    },
    {
     "utterance": "그때 하신 말씀대로 해 주세요.",
     "label": "promised_discount",
     "type": "insist"
    },
    {
     "utterance": "재봉사 할머니가 가게를 닫는다고 하던데요.",
     "label": "heard_rumor",
     "type": "rumor_after_claim"
    },
    {
     "utterance": "실도 같이 살게요.",
     "label": "none",
     "type": "none"
    }
   ]
  },
  {
   "dialogue_id": "K11",
   "lines": [
    {
     "utterance": "시키신 대로 우물가 장작 다 쪼개 놨어요.",
