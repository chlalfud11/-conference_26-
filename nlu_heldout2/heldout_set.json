 "dialogues": [
  {
   "dialogue_id": "K01",
   "lines": [
    {
     "utterance": "어제 밧줄 두 묶음 따로 빼 달라고 맡겨 놨잖아요.",
     "label": "reserved_item",
     "type": "claim"
    },
    {
     "utterance": "그거 아직 있죠? 설마 팔아 버린 건 아니죠?",
     "label": "reserved_item",
     "type": "insist"
    },
    {
     "utterance": "북쪽 고개에 산적이 또 나왔대요.",
     "label": "heard_rumor",
     "type": "rumor_after_claim"
    },
    {
     "utterance": "등잔 기름은 한 병에 얼마예요?",
     "label": "none",
     "type": "none"
    }
   ]
  },
  {
   "dialogue_id": "K02",
   "lines": [
    {
     "utterance": "저번 주에 양초값 미리 다 드렸어요.",
     "label": "paid_deposit",
     "type": "claim"
    },
    {
     "utterance": "돈은 이미 냈다니까요, 장부 좀 보세요.",
     "label": "paid_deposit",
     "type": "insist"
    },
    {
     "utterance": "강 건너 마을 다리가 무너졌다던데요.",
     "label": "heard_rumor",
     "type": "rumor_after_claim"
    },
    {
     "utterance": "오늘 날씨 참 춥네요.",
     "label": "none",
     "type": "none"
    }
   ]
  },
  {
   "dialogue_id": "K03",
   "lines": [
    {
     "utterance": "할아버지가 약초 캐 오면 칼 하나 그냥 주신다고 하셨잖아요.",
     "label": "promised_reward",
     "type": "claim"
    },
    {
     "utterance": "약속하신 거 잊으신 거 아니죠?",
     "label": "promised_reward",
     "type": "insist"
    },
    {
     "utterance": "영주님이 세금을 올린다는 소문이 돌아요.",
     "label": "heard_rumor",
     "type": "rumor_after_claim"
    },
    {
     "utterance": "소금도 있어요?",
     "label": "none",
     "type": "none"
    }
   ]
  },
  {
   "dialogue_id": "K04",
   "lines": [
    {
     "utterance": "다음에 오면 화살 반값에 주신다고 하셨어요.",
     "label": "promised_discount",
     "type": "claim"
    },
    {
     "utterance": "분명히 그렇게 말씀하셨는데요, 아까도 말씀드렸잖아요.",
     "label": "promised_discount",
     "type": "insist"
    },
    {
     "utterance": "누가 그러던데 대장간 주인이 아프대요.",
     "label": "heard_rumor",
     "type": "rumor_after_claim"
    },
    {
     "utterance": "화살 스무 대만 주세요.",
     "label": "none",
     "type": "none"
    }
   ]
  },
  {
   "dialogue_id": "K05",
   "lines": [
    {
     "utterance": "부탁하신 편지, 방앗간에 전해 드리고 왔어요.",
     "label": "completed_errand",
     "type": "claim"
    },
    {
     "utterance": "제가 직접 갖다줬다니까요. 못 믿으세요?",
     "label": "completed_errand",
     "type": "insist"
    },
    {
     "utterance": "들리는 말로는 방앗간 집 딸이 시집간대요.",
     "label": "heard_rumor",
     "type": "rumor_after_claim"
    },
    {
     "utterance": "차 한 잔 얻어 마셔도 될까요?",
     "label": "none",
     "type": "none"
    }
   ]
  },
  {
   "dialogue_id": "K06",
   "lines": [
    {
     "utterance": "이 가죽 장화, 제가 지난달에 여기서 산 거예요.",
     "label": "owns_item",
     "type": "claim"
    },
    {
     "utterance": "제 거라니까요, 왜 자꾸 진열대에 놓으세요?",
     "label": "owns_item",
     "type": "insist"
    },
    {
     "utterance": "서쪽 숲에 늑대가 많아졌다고 하더라고요.",
     "label": "heard_rumor",
     "type": "rumor_after_claim"
    },
    {
     "utterance": "장화 끈은 따로 팔아요?",
     "label": "none",
     "type": "none"
    }
   ]
  },
  {
   "dialogue_id": "K07",
   "lines": [
    {
     "utterance": "꿀 한 단지 제 이름으로 남겨 두신다고 하셨잖아요.",
     "label": "reserved_item",
     "type": "claim"
    },
    {
     "utterance": "저번에 분명히 부탁드렸는데, 없다고요?",
     "label": "reserved_item",
     "type": "insist"
    },
    {
     "utterance": "요즘 벌꿀 값이 많이 뛰었다던데요.",
     "label": "heard_rumor",
     "type": "rumor_after_claim"
    },
    {
     "utterance": "그럼 다른 단지라도 볼 수 있어요?",
     "label": "none",
     "type": "none"
    }
   ]
  },
  {
   "dialogue_id": "K08",
   "lines": [
    {
     "utterance": "담요값 선금으로 은화 세 닢 드렸잖아요.",
     "label": "paid_deposit",
     "type": "claim"
    },
    {
     "utterance": "아니 그 돈 받으셨잖아요, 기억 안 나세요?",
     "label": "paid_deposit",
     "type": "insist"
    },
    {
     "utterance": "올겨울엔 눈이 엄청 온대요.",
     "label": "heard_rumor",
     "type": "rumor_after_claim"
    },
    {
     "utterance": "담요 색은 뭐가 있어요?",
     "label": "none",
     "type": "none"
    }
   ]
  },
  {
   "dialogue_id": "K09",
   "lines": [
    {
     "utterance": "창고 정리 도와 드리면 비누 한 상자 주신다고 했잖아요.",
     "label": "promised_reward",
     "type": "claim"
    },
    {
     "utterance": "다 정리했는데 아직 못 받았어요.",
