     "type": "rumor_after_claim"
    }
   ]
  },
  {
   "dialogue_id": "K23",
   "lines": [
    {
     "utterance": "이 비누 냄새 좋네요.",
     "label": "none",
     "type": "none"
    },
    {
     "utterance": "향초 사면 비누 하나 공짜로 주신다고 하셨어요.",
     "label": "promised_reward",
     "type": "claim"
    },
    {
     "utterance": "공짜로 주신다면서요.",
     "label": "promised_reward",
     "type": "insist"
    },
    {
     "utterance": "귀족 아가씨들 사이에서 이 향이 유행이래요.",
